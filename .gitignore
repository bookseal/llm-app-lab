# Secrets — never commit real API keys (.env.example is the safe template)
.env

# Python
.venv/
__pycache__/
*.pyc

# Node
node_modules/
frontend/dist/

# Generated at build time from git log (not committed)
docs/history.html

# RAG index artifacts — regenerated by `python indexer.py` (large binaries, don't commit)
*.pkl
index.meta.json

# Exported Claude Code transcripts — local reference only. They contain raw shell
# output, absolute paths and env values, and this repo is public. The exporter
# script itself IS tracked; regenerate with `python3 claude-sessions/export_sessions.py`
claude-sessions/*.md

# OS
.DS_Store
