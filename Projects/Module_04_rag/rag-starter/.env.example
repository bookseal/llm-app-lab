# Which generation backend to use. See llm.PROVIDERS for the full registry.
# Retrieval/embeddings are local (sentence-transformers) and cost nothing either way.
LLM_PROVIDER=anthropic
# LLM_MODEL=            # optional: override the provider's default model

ANTHROPIC_API_KEY=sk-ant-...your-key-here...

# ── Anthropic-compatible endpoints (no code translation needed) ──
# ZAI_API_KEY=          # LLM_PROVIDER=glm        glm-4.7-flash is FREE  → z.ai
# DEEPSEEK_API_KEY=     # LLM_PROVIDER=deepseek   $0.14/$0.28 per 1M tok
# MOONSHOT_API_KEY=     # LLM_PROVIDER=kimi       paid

# ── OpenAI-compatible endpoints (translated by llm.py) ──
# GEMINI_API_KEY=       # LLM_PROVIDER=gemini     FREE tier → aistudio.google.com
# GROQ_API_KEY=         # LLM_PROVIDER=groq       FREE tier, very fast
# OPENROUTER_API_KEY=   # LLM_PROVIDER=openrouter FREE — models ending in :free
#                       # LLM_PROVIDER=ollama     local, no key needed at all
